rules_version = '2';

// Adjuntos de chat, videos, PDFs de KB y fotos de perfil.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAgent() { return signedIn() && request.auth.token.kind == 'agent'; }
    function isAdmin() { return isAgent() && request.auth.token.rol == 'admin'; }
    function isContact() { return signedIn() && request.auth.token.kind == 'contact'; }

    // Adjuntos por conversación: adjuntos/{convId}/{archivo}
    // Las reglas de Storage NO pueden leer Firestore, así que la pertenencia a
    // la conversación no es verificable acá. La confidencialidad se apoya en:
    //   (1) sesión válida (isAgent/isContact), y
    //   (2) el nombre de archivo lleva un segmento ALEATORIO no adivinable
    //       (ver sendAttachment/agentSendAttachment), de modo que conocer el
    //       convId — incluso los ids determinísticos de grupo — no permite
    //       construir/descargar la ruta de otra conversación.
    // Migración más fuerte pendiente: servir descargas por Signed URL desde una
    // Function que valide pertenencia y cerrar la lectura directa.
    match /adjuntos/{convId}/{file} {
      allow read: if isAgent() || isContact();
      allow write: if (isAgent() || isContact()) &&
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*') ||
         request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('application/.*document.*') ||
         request.resource.contentType == 'application/vnd.ms-excel' ||
         request.resource.contentType.matches('text/.*'));
    }

    // Archivos de la base de conocimiento: kb/{docId}.(pdf|txt|md) — solo admins suben.
    match /kb/{file} {
      allow read: if isAgent();
      allow write: if isAdmin() &&
        (request.resource.contentType == 'application/pdf' ||
         request.resource.contentType.matches('text/.*')) &&
        request.resource.size < 50 * 1024 * 1024;
    }

    // Fotos de perfil del equipo y avatar del bot.
    match /perfiles/{file} {
      allow read: if signedIn();
      allow write: if isAgent() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 5 * 1024 * 1024;
    }
  }
}
