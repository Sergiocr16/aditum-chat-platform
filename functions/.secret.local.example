# Copiá este archivo a functions/.secret.local para desarrollo con emuladores.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: embeddings reales para la base de conocimiento (sin ella, fallback por keywords)
VOYAGE_API_KEY=pa-...
# Opcional: token de GitHub de solo lectura (Contents: read) para indexar el repo de producción (codeSync)
GITHUB_CODE_TOKEN=github_pat_...
# Shared with the investigator on the Raspberry Pi (openssl rand -hex 32).
RUNNER_SHARED_SECRET=
# Only for the gateway on the Pi, which needs the MySQL password (openssl rand -hex 32).
GATEWAY_SHARED_SECRET=
