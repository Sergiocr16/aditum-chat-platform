# Copy to functions/.env (gitignored). Firebase loads it for the emulators and on deploy.
# This repo is public, so production's repository and package live here and not in the code.

# The production repository the code index and the investigator read, as owner/repo@branch.
CODE_REPO=
# Its Java package, as a path under src/main/java: com/example/app
CODE_JAVA_PACKAGE=
