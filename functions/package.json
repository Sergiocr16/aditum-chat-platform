{
  "name": "@aditum-chat/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:bot": "esbuild evals/bot-eval.ts --bundle --platform=node --format=cjs --packages=external --alias:@aditum-chat/shared=../packages/shared/src/index.ts --outfile=lib/bot-eval.cjs --log-level=warning && node lib/bot-eval.cjs",
    "dev": "node esbuild.mjs --watch",
    "seed": "node scripts/seed.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "pdf-parse": "^1.1.1",
    "ssh2": "^1.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3"
  }
}
