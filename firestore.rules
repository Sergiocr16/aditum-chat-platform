rules_version = '2';

// Aditum Chat — aislamiento multitenant.
// Dos tipos de identidad (custom claims):
//   contact: { kind: 'contact', siteId, clientId?, groupId?, contactId }  ← widget
//   agent:   { kind: 'agent', rol: 'admin' | 'agente' }         ← consola
// Las escrituras sensibles (tickets, claves, equipo) pasan por Cloud Functions.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAgent() { return signedIn() && request.auth.token.kind == 'agent'; }
    function isAdmin() { return isAgent() && request.auth.token.rol == 'admin'; }
    function isContact() { return signedIn() && request.auth.token.kind == 'contact'; }
    function myContactId() { return request.auth.token.contactId; }
    function myClientId() { return request.auth.token.get('clientId', ''); }
    function myGroupId() { return request.auth.token.get('groupId', ''); }

    // ------------------------------------------------------------------ sitios
    match /sites/{siteId} {
      allow read: if isAgent();
      allow write: if isAdmin();

      // Claves de cifrado: SOLO Admin SDK (functions). Nadie desde cliente.
      match /secrets/{doc} {
        allow read, write: if false;
      }
    }

    // ----------------------------------------------------------------- clientes
    match /clients/{clientId} {
      allow read: if isAgent() || (isContact() && myClientId() == clientId);
      // Admin edita todo; un agente solo puede tocar las etiquetas del condominio.
      allow update: if isAdmin() ||
        (isAgent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags']));
      allow create, delete: if isAdmin();
    }

    // ------------------------------------------------------------------- grupos
    // Organizaciones (administradoras) con su lista de clientes. Las escribe
    // widgetSession (Admin SDK) con lo que declara el host; desde la consola
    // los agentes solo pueden tocar las etiquetas.
    match /groups/{groupId} {
      allow read: if isAgent() || (isContact() && myGroupId() == groupId);
      allow update: if isAgent() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags']);
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------- contactos
    match /contacts/{contactId} {
      allow read: if isAgent() || (isContact() && myContactId() == contactId);
      // Alta/actualización de contactos la hace widgetSession (Admin SDK).
      // Los agentes también asignan etiquetas (contacts.tags).
      allow write: if isAgent();
    }

    // ---------------------------------------------------------- etiquetas (tags)
    // Catálogo de etiquetas por sitio. Lo administran los Admin en Configuración;
    // cualquier agente las lee para mostrarlas/asignarlas en el panel.
    match /tags/{tagId} {
      allow read: if isAgent();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ conversaciones
    match /conversations/{convId} {

      function convData() { return resource.data; }
      function participaEnConv() {
        return isContact() && (
          (convData().tipo == 'directa' && convData().contactId == myContactId()) ||
          (convData().tipo == 'grupo' && myContactId() in convData().get('participantes', []))
        );
      }

      allow read: if isAgent() || participaEnConv();
      // El contacto crea sus conversaciones directas propias, o un nuevo segmento
      // del chat grupal de su cliente (siempre incluyéndose en participantes), de
      // su sitio. Los segmentos de grupo se encadenan como las directas.
      allow create: if isAgent() || (
        isContact() &&
        request.resource.data.siteId == request.auth.token.siteId && (
          (request.resource.data.tipo == 'directa' &&
            request.resource.data.contactId == myContactId()) ||
          (request.resource.data.tipo == 'grupo' &&
            myContactId() in request.resource.data.participantes)
        )
      );
      // Contacto: solo campos de actividad (lastMessage/unread/updatedAt/silenciado)
      // vía su chat. NO puede tocar `estado` ni `botIntentos`: son estado de ciclo
      // de vida que maneja el backend (botReply/handoff). Si el contacto pudiera
      // resetearlos, evitaría el auto-escalamiento y mantendría al bot (Claude)
      // respondiendo sin límite → costo de API sin techo.
      allow update: if isAgent() || (
        participaEnConv() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'unread', 'updatedAt', 'silenciado'])
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        function parentConv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }
        function participaEnParent() {
          return isContact() && (
            (parentConv().tipo == 'directa' && parentConv().contactId == myContactId()) ||
            (parentConv().tipo == 'grupo' && myContactId() in parentConv().get('participantes', []))
          );
        }

        // Las notas internas (interno == true) jamás se leen desde el widget.
        allow read: if isAgent() ||
          (participaEnParent() && resource.data.get('interno', false) == false);
        allow create: if isAgent() || (
          participaEnParent() &&
          request.resource.data.sender.tipo == 'user' &&
          request.resource.data.sender.id == myContactId() &&
          request.resource.data.get('interno', false) == false
        );
        // Edición y reacciones del propio contacto; agentes libres.
        allow update: if isAgent() || (
          participaEnParent() && (
            resource.data.sender.id == myContactId() ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reacciones', 'leidoPor'])
          )
        );
        allow delete: if isAgent();
      }
    }

    // ------------------------------------------------------------------ tickets
    match /tickets/{ticketId} {

      function ticketVisibleParaContacto() {
        return isContact() && (
          resource.data.get('contactId', '') == myContactId() ||
          (resource.data.publico == true && (
            resource.data.ambito == 'sistema' ||
            (myClientId() != '' && resource.data.get('clientId', '') == myClientId()) ||
            (myGroupId() != '' && resource.data.get('groupId', '') == myGroupId())
          ))
        );
      }

      allow read: if isAgent() || ticketVisibleParaContacto();
      // Creación/edición solo por agentes o functions (createTicket).
      allow write: if isAgent();

      match /historial/{eventId} {
        function parentTicket() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
        }
        allow read: if isAgent() || (isContact() && (
          parentTicket().get('contactId', '') == myContactId() ||
          (parentTicket().publico == true && (
            parentTicket().ambito == 'sistema' ||
            (myClientId() != '' && parentTicket().get('clientId', '') == myClientId()) ||
            (myGroupId() != '' && parentTicket().get('groupId', '') == myGroupId())
          ))
        ));
        allow write: if isAgent();
      }

      match /notas/{notaId} {
        // Notas internas: exclusivas del equipo.
        allow read, write: if isAgent();
      }
    }

    // ------------------------------------------------------------------- equipo
    match /team/{uid} {
      allow read: if isAgent();
      // Alta/roles vía function manageTeam; el propio agente edita su perfil básico.
      allow update: if isAdmin() || (isAgent() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombreChat', 'fotoUrl', 'idioma', 'presencia', 'nombre', 'fcmTokens']));
      allow create, delete: if isAdmin();
    }

    // ----------------------------------------------------------------- settings
    match /settings/{doc} {
      allow read: if isAgent();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------------- KB
    match /kb/{docId} {
      allow read: if isAgent();
      allow write: if isAdmin();
      match /chunks/{chunkId} {
        allow read: if isAgent();
        allow write: if false; // solo kbIngest (Admin SDK)
      }
    }

    // --------------------------------------------------------------------- CSAT
    match /csat/{id} {
      // Agentes leen todo; un contacto solo sus propias valoraciones (para que el
      // widget sepa qué conversaciones ya calificó y no vuelva a pedir CSAT).
      allow read: if isAgent() || (isContact() && resource.data.contactId == myContactId());
      allow create: if isContact() && request.resource.data.contactId == myContactId();
      allow update, delete: if false;
    }

    // ------------------------------------------------------- feedback del bot
    // Voto "¿te sirvió?" por respuesta del bot. docId = `${convId}_${msgId}`
    // (un voto por mensaje). El trigger onBotFeedbackWrite estampa el voto en
    // el mensaje y ejecuta el escalamiento cuando escalate pasa a true.
    match /bot_feedback/{id} {
      allow read: if isAgent() || (isContact() && resource.data.contactId == myContactId());
      allow create: if isContact()
        && request.resource.data.contactId == myContactId()
        && request.resource.data.helpful is bool;
      // Única mutación permitida: aceptar la oferta de agente tras un voto negativo.
      allow update: if isContact()
        && resource.data.contactId == myContactId()
        && resource.data.helpful == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['escalate'])
        && request.resource.data.escalate == true;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ métricas
    match /metrics_daily/{doc} {
      allow read: if isAgent();
      allow write: if false; // solo functions (Admin SDK)
    }

    // -------------------------------------------------------------- notificaciones
    match /notifications/{id} {
      allow read: if isAgent();
      allow write: if false; // solo slaEngine (Admin SDK)
    }

    // ----------------------------------------------------------------- counters
    match /counters/{doc} {
      allow read, write: if false; // solo functions
    }
  }
}
